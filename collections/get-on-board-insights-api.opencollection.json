{
  "opencollection": "1.0.0",
  "info": {
    "name": "Get on Board Applications Insights API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Insights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
