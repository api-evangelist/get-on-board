              },
              {
                "name": "id",
                "value": "test_query",
                "type": "path",
                "description": "Insight query ID."
              },
              {
                "name": "no_cache",
                "value": "true",
                "type": "query"
              },
              {
                "name": "year",
                "value": "2024",
                "type": "query",
                "description": "Calendar year used to filter insight data."
              }
            ]
          },
          "docs": "Get an insight"
        }
      ]
    }
  ],
  "bundled": true
